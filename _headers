# Netlify Production HTTP Headers & Security Configuration
# NeoNeX MindX - https://neonexmindx.com

# 1. Global Security, Compression & Indexing Headers
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# 2. Immutable Cache for Static WebP Images & Media Assets (1 Year Cache)
/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.jpeg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.woff
  Cache-Control: public, max-age=31536000, immutable

# 3. Dynamic HTML Pages - Fast Revalidation
/*.html
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: text/html; charset=utf-8

/
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: text/html; charset=utf-8

# 4. JSON Data API & CMS Feeds
/data/*.json
  Cache-Control: public, max-age=300, must-revalidate
  Access-Control-Allow-Origin: *

# 5. Crawler / LLM Text Directives
/robots.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8

/sitemap.xml
  Cache-Control: public, max-age=86400
  Content-Type: application/xml; charset=utf-8

/llms.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8

# 6. Internal Hubs Security & Confidentiality Directives
/cms/*
  X-Robots-Tag: noindex, nofollow, noarchive

/crm/*
  X-Robots-Tag: noindex, nofollow, noarchive

/digital-marketing/*
  X-Robots-Tag: noindex, nofollow, noarchive
